# Neon PostgreSQL Connection String
DATABASE_URL="postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Secret minimal 32 karakter untuk JWT session cookie
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Penyimpanan foto: "gdrive" (production/online) atau "local" (testing lokal)
STORAGE_PROVIDER="gdrive"

# Kredensial OAuth2 Google Drive pribadi (jalankan: node scripts/get-gdrive-token.mjs)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""

# Kredensial akun seed awal (opsional, ada default di seed.ts)
SEED_ADMIN_PASSWORD=""
SEED_PETUGAS_PASSWORD=""
